#!/usr/bin/env bash
set -euo pipefail

arch=${0##*/}
arch=${arch%-musl-cc}
args=()
for arg in "$@"; do
  # cc-rs uses Rust's target-triple spelling, which Zig does not accept.
  if [[ $arg != "--target=$arch-unknown-linux-musl" ]]; then
    args+=("$arg")
  fi
done
exec zig cc -target "$arch-linux-musl" "${args[@]}"
